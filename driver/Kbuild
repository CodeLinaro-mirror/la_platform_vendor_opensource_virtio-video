#
# Kbuild for the virtio-video driver
#
KBUILD_CPPFLAGS += -DVIRTIO_VIDEO_MSM
KBUILD_CPPFLAGS += -DMSM_HAB_NO_SUPPORT

ccflags-y := -I"$(src)/include/uapi"
virtio_video-y := \
	virtio_video_driver.o \
	virtio_video_vq.o \
	virtio_video_device.o \
	virtio_video_dec.o \
	virtio_video_enc.o \
	virtio_video_cam.o \
	virtio_video_caps.o \
	virtio_video_helpers.o\
	virtio_video_msm_driver.o\
	virtio_video_msm_hab.o \
	virtio_video_msm_debug.o \
	virtio_video_msm_v4l2.o \
	virtio_video_msm_vq.o \
	virtio_video_msm_vb2.o \
	virtio_video_msm_mem.o

obj-m += virtio_video.o

ccflags-y += -DDRIVER_VERSION=\"2.3.0\"
